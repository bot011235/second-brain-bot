# === Telegram ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=change-me-random-secret-string
TG_CHAT_ID=0
ALLOWED_TG_USER_ID=0

# ID топиков (message_thread_id). Топик General не имеет ID (None).
# Запустите `python scripts/dev_polling.py --discover` и напишите сообщение в каждый топик, чтобы узнать их ID.
TOPIC_MOVIES_ID=0
TOPIC_BOOKS_ID=0
TOPIC_IDEAS_ID=0
TOPIC_YOUTUBE_ID=0
TOPIC_ARTICLES_ID=0

# === Turso (libSQL) — если пусто, используется локальный файл data/second_brain.db ===
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
LOCAL_DB_PATH=data/second_brain.db

# === Groq LLM ===
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_FOR_IDEAS=true

# === Внешние медиа-API (все официальные) ===
TMDB_API_KEY=
GOOGLE_BOOKS_API_KEY=
YOUTUBE_API_KEY=

# === Публичный URL сервиса (для TMA и Webhook) ===
PUBLIC_BASE_URL=
